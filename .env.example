# GEMINI_API_KEY: Required if enabling server-side Gemini API capabilities.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this app is deployed (e.g., https://your-app.vercel.app)
APP_URL="http://localhost:3000"

# SESSION_SECRET: Recommended 64-char hex secret for HMAC session signing on Vercel/production
SESSION_SECRET=""

# E2E_LOG_KEY: Optional 64-char hex AES-256-GCM key for log encryption across serverless instances
E2E_LOG_KEY=""

# Optional bootstrap SOC administrator credentials (useful on stateless serverless deployments)
ADMIN_EMAIL=""
ADMIN_PASSCODE=""
